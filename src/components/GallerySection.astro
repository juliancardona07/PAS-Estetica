---
const galleryItems = [
  {
    title: "Cabina de Calma & Aromaterapia",
    category: "Espacio",
    image: "/images/spa-interior.webp",
    width: 640,
    height: 480
  },
  {
    title: "Cuidado Facial con Extracción Suave",
    category: "Facial Holístico",
    image: "/images/facial-care.webp",
    width: 640,
    height: 480
  },
  {
    title: "Terapia de Piedras Volcánicas Calientes",
    category: "Equilibrio & Energía",
    image: "/images/hot-stones.webp",
    width: 640,
    height: 480
  },
  {
    title: "Rituales con Aceites Botánicos Puros",
    category: "Aromaterapia",
    image: "/images/aromatherapy.webp",
    width: 640,
    height: 480
  },
  {
    title: "Moldeo Corporal & Drenaje Manual",
    category: "Corporal Consciente",
    image: "/images/body-care.webp",
    width: 640,
    height: 480
  },
  {
    title: "Masaje Craneofacial & Armonización",
    category: "Bienestar 360°",
    image: "/images/holistic-massage.webp",
    width: 640,
    height: 480
  }
];
---

<section id="experiencia" class="py-20 sm:py-28 bg-gradient-to-b from-stone-50 via-teal-50/40 to-purple-50/40 scroll-mt-20 border-t border-purple-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-teal-100 text-teal-900 border border-teal-300 text-xs font-bold uppercase tracking-wider">
          Nuestros Espacios & Experiencia
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight">
          Un vistazo a la <span class="font-serif italic font-normal text-purple-800">atmósfera</span> que te espera.
        </h2>
        <p class="text-base text-slate-700 leading-relaxed">
          Cada rincón de nuestra cabina en Bogotá está pensado para estimular tus sentidos a través de texturas suaves, iluminación tenue y aromas botánicos reconfortantes.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="https://www.instagram.com/pasesteticaholistica"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-purple-700 hover:text-purple-900 border-b border-purple-300 pb-0.5 hover:border-purple-700 transition-colors"
        >
          <span>Ver más en Instagram @pasesteticaholistica</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {galleryItems.map((item) => (
        <div class="group relative rounded-2xl overflow-hidden bg-slate-100 shadow-xs hover:shadow-xl transition-all duration-300 border border-slate-200/70">
          <div class="aspect-4/3 overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              width={item.width}
              height={item.height}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent opacity-90 group-hover:opacity-95 transition-opacity flex flex-col justify-end p-5 text-white">
            <span class="text-[11px] font-bold uppercase tracking-widest text-teal-300">
              {item.category}
            </span>
            <h3 class="text-base font-semibold leading-snug mt-1 text-slate-100">
              {item.title}
            </h3>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
