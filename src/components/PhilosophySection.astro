---
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import SectionDivider from './SectionDivider.astro';

const pillars = [
  {
    number: "01",
    title: "Enfoque 360° Integral",
    subtitle: "Cuerpo, Mente & Energía",
    description: "No nos limitamos a la superficie o al síntoma aislado. Comprendemos que tu piel refleja tu estado interior, digestivo y emocional. Cuidamos tu dermis mientras equilibramos tu nivel de estrés.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
  },
  {
    number: "02",
    title: "Santuario de Pausa",
    subtitle: "Desconexión sin prisas",
    description: "Frente al ajetreo de Bogotá, P.A.S es un refugio donde el tiempo se detiene. Integramos aromaterapia pura, sábanas cálidas, música binaural y silencio para reiniciar tu mente.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    number: "03",
    title: "Eficacia con Consciencia",
    subtitle: "Tecnología & Botánica",
    description: "Combinamos aparatología estética de vanguardia (radiofrecuencia, ultrasonido, electroporación) con activos botánicos biocompatibles, sin dolor y respetando tu fisionomía.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  },
  {
    number: "04",
    title: "Atención 1 a 1 Humana",
    subtitle: "Sin recetas en serie",
    description: "Cada cita es única. Realizamos un diagnóstico inicial y adaptamos cada producto y maniobra a cómo te sientes hoy, tus hábitos y lo que tu piel verdaderamente necesita.",
    icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
  }
];
---

<!-- =====================================================================
     SECCIÓN 3 (FILOSOFÍA 360°): CIENCIA DÉRMICA, ARMONÍA INTERIOR & RESULTADOS
     Asociada directamente al botón "Filosofía 360°" (#filosofia) del Header.
     ===================================================================== -->
<section id="filosofia" class="relative py-20 sm:py-28 bg-gradient-to-b from-stone-50 via-purple-50/40 to-stone-50 overflow-hidden scroll-mt-20">
  
  <!-- Decorative soft blurs -->
  <div class="absolute top-12 right-10 -z-10 w-80 h-80 rounded-full bg-purple-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-10 -z-10 w-80 h-80 rounded-full bg-teal-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- PARTE 1: Ciencia Dérmica & Armonía Interior + Antes y Después -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center pb-16 sm:pb-24">
      
      <!-- Narrative & Bento Pillars (6 cols) -->
      <div class="lg:col-span-6 space-y-6 sm:space-y-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-900 text-xs uppercase tracking-widest font-bold">
          Filosofía 360° · Ciencia Dérmica & Armonía Interior
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.15]">
          Un santuario diseñado para la <span class="font-serif italic font-normal text-purple-800">desconexión total</span> y resultados visibles.
        </h2>

        <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
          Más que una cabina estética tradicional, <strong class="text-slate-900 font-semibold">P.A.S</strong> integra protocolos clínicos no invasivos de alta eficacia con aromaterapia y armonización energética. Aquí no vienes con prisa: cada sesión renueva tu piel mientras libera el estrés acumulado en tu cuerpo.
        </p>

        <!-- Bento Trust Cards (3 Pillars) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              360°
            </span>
            <h3 class="text-sm font-bold text-slate-900">Enfoque Integral</h3>
            <p class="text-xs text-slate-600 mt-0.5">Cuerpo, mente y energía en sintonía</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-teal-200/80 shadow-xs hover:shadow-md hover:border-teal-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-teal-50 text-teal-800 font-serif font-bold text-lg mb-2">
              1:1
            </span>
            <h3 class="text-sm font-bold text-slate-900">Sin Prisas</h3>
            <p class="text-xs text-slate-600 mt-0.5">Cabina privada exclusiva para ti</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              100%
            </span>
            <h3 class="text-sm font-bold text-slate-900">A tu Medida</h3>
            <p class="text-xs text-slate-600 mt-0.5">Diagnóstico previo personalizado</p>
          </div>
        </div>

        <!-- Secondary link to catalog -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="#servicios"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-purple-900 bg-white hover:bg-purple-50 border-2 border-purple-200 shadow-xs transition-all min-h-[48px]"
          >
            <span>Ver Carta de Tratamientos</span>
            <span aria-hidden="true">↑</span>
          </a>
        </div>
      </div>

      <!-- Interactive Before/After Showcase (6 cols) -->
      <div class="lg:col-span-6 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Ambient frame border with purple & mint gradient -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-purple-400/30 via-teal-300/30 to-purple-200/40 blur-md -z-10" aria-hidden="true"></div>
          
          <BeforeAfterSlider />

          <!-- Location & Exclusivity badge below slider -->
          <div class="mt-4 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md border border-purple-200 shadow-md flex items-center justify-between text-xs text-slate-700">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-bold text-slate-900">Atención Exclusiva en Bogotá</span>
            </div>
            <span class="text-purple-800 font-semibold text-[11px]">
              Carrera 53A #127 · Cita previa
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- Internal Lotus Divider between Parte 1 and Parte 2 of Filosofía 360° -->
    <SectionDivider className="mb-16 sm:mb-20" />

    <!-- PARTE 2: Los 4 Pilares del Enfoque Holístico 360° -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-purple-100 text-purple-900 border border-purple-300 text-xs uppercase tracking-widest font-bold">
        Nuestra Razón de Ser
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight">
        ¿Por qué un enfoque <span class="font-serif italic font-normal text-purple-800">holístico</span> marca la diferencia?
      </h2>
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
        La estética convencional suele perseguir únicamente el síntoma visible mediante protocolos rápidos y estandarizados. En P.A.S entendemos que el brillo duradero nace del bienestar integral.
      </p>
    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mt-16">
      {pillars.map((pillar, i) => (
        <div class="relative p-7 rounded-3xl bg-white border-2 border-purple-200/70 hover:border-teal-400 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="font-serif text-3xl font-bold text-purple-300 group-hover:text-purple-600 transition-colors">
                {pillar.number}
              </span>
              <div class={`w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-sm transition-transform duration-300 group-hover:scale-110 ${i % 2 === 0 ? 'bg-gradient-to-tr from-purple-700 to-purple-500' : 'bg-gradient-to-tr from-teal-600 to-teal-400'}`}>
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.icon} />
                </svg>
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-900 group-hover:text-purple-900 transition-colors">
              {pillar.title}
            </h3>
            <p class="text-xs uppercase tracking-wider text-teal-700 font-bold mt-1 mb-3">
              {pillar.subtitle}
            </p>
            <p class="text-sm text-slate-600 leading-relaxed">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Comparative Table/Card -->
    <div class="mt-16 bg-gradient-to-br from-purple-900 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl overflow-hidden relative">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-purple-600/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
      
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5 space-y-4">
          <span class="inline-block px-3 py-1 rounded-full bg-purple-500/20 border border-purple-400/30 text-purple-200 text-xs font-semibold tracking-wider uppercase">
            Transformación Real
          </span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold leading-snug">
            Tratar la piel no es un trámite acelerado, es un acto de amor propio.
          </h3>
          <p class="text-sm text-purple-100/90 leading-relaxed">
            Te invitamos a regalarte un momento donde el teléfono queda afuera, el ritmo se detiene y cada procedimiento tiene como fin devolverte la serenidad y la vitalidad a tu rostro y cuerpo.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Conventional box -->
          <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
            <h4 class="text-sm font-bold text-rose-300 uppercase tracking-wider mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Estética Convencional
            </h4>
            <ul class="space-y-2 text-xs text-slate-300">
              <li class="flex items-start gap-2">• Citas apresuradas con tiempos cronometrados.</li>
              <li class="flex items-start gap-2">• Tratamiento aislado solo sobre la arruga o mancha.</li>
              <li class="flex items-start gap-2">• Procedimientos dolorosos o que dejan marcas.</li>
              <li class="flex items-start gap-2">• Fórmulas genéricas iguales para todos.</li>
            </ul>
          </div>

          <!-- PAS Holistic box -->
          <div class="p-5 rounded-2xl bg-purple-500/20 border border-purple-400/40 backdrop-blur-xs">
            <h4 class="text-sm font-bold text-teal-300 uppercase tracking-wider mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Enfoque Holístico P.A.S
            </h4>
            <ul class="space-y-2 text-xs text-purple-50">
              <li class="flex items-start gap-2">• Espacio exclusivo para ti, sin interferencias ni apuros.</li>
              <li class="flex items-start gap-2">• Cuidado 360° que calma el sistema nervioso.</li>
              <li class="flex items-start gap-2">• Protocolos no invasivos, gentiles y reconfortantes.</li>
              <li class="flex items-start gap-2">• Diagnóstico y selección personalizada de activos.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
