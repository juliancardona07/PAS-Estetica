---
interface Props {
  id: string;
  name: string;
  category: string;
  shortDescription: string;
  duration: string;
  price: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  popular?: boolean;
  benefits: string[];
}

const {
  name,
  category,
  shortDescription,
  duration,
  price,
  image,
  imageWidth,
  imageHeight,
  popular = false,
  benefits,
} = Astro.props;

const whatsappServiceUrl = "https://wa.me/573118735759?text=" + encodeURIComponent(`Hola Paula, me comunico desde la web y me interesa agendar el servicio: "${name}" (${price}). ¿Qué disponibilidad tienes?`);
---

<article class="relative flex flex-col bg-white rounded-3xl overflow-hidden border border-purple-100/80 hover:border-purple-300 shadow-xs hover:shadow-xl transition-all duration-300 group">
  {popular && (
    <div class="absolute top-4 right-4 z-20 px-3.5 py-1 rounded-full bg-purple-700 text-white text-xs font-semibold tracking-wider shadow-md">
      Recomendado
    </div>
  )}

  <!-- Service Image Container -->
  <div class="relative h-56 sm:h-64 overflow-hidden bg-slate-100">
    <img
      src={image}
      alt={`Tratamiento de ${name} en P.A.S Estética Holística Bogotá`}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
    <span class="absolute bottom-3 left-4 px-3 py-1 rounded-md bg-white/90 backdrop-blur-xs text-xs font-bold text-purple-900 tracking-wide">
      {category}
    </span>
  </div>

  <!-- Content Body -->
  <div class="p-6 sm:p-7 flex flex-col flex-grow justify-between space-y-6">
    <div class="space-y-3">
      <!-- Title & Price Bar -->
      <div class="flex items-start justify-between gap-3">
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-purple-800 transition-colors leading-snug">
          {name}
        </h3>
      </div>

      <div class="flex items-center gap-3 text-sm">
        <span class="font-bold text-lg text-purple-900">{price}</span>
        <span class="text-slate-300">•</span>
        <span class="flex items-center text-slate-600 text-xs font-medium bg-purple-50 px-2.5 py-1 rounded-md border border-purple-100">
          <svg class="w-3.5 h-3.5 mr-1 text-purple-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {duration}
        </span>
      </div>

      <p class="text-sm text-slate-600 leading-relaxed">
        {shortDescription}
      </p>

      <!-- Benefits list -->
      <div class="pt-2 border-t border-slate-100">
        <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 mb-2">
          Lo que incluye y beneficios:
        </p>
        <ul class="space-y-1.5 text-xs text-slate-700">
          {benefits.map((benefit) => (
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-teal-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Booking CTA button -->
    <div class="pt-4 border-t border-purple-50">
      <a
        href={whatsappServiceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-purple-900 bg-purple-50 hover:bg-purple-700 hover:text-white border border-purple-200 transition-colors duration-200 focus:outline-hidden focus:ring-2 focus:ring-purple-500 min-h-[44px]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Agendar este Servicio</span>
      </a>
    </div>
  </div>
</article>
