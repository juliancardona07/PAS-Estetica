---
interface Benefit {
  title: string;
  text: string;
}

interface ModalItem {
  name: string;
  badge?: string;
  description: string;
}

interface ModalSection {
  title: string;
  subtitle?: string;
  items: ModalItem[];
}

interface Props {
  id: string;
  name: string;
  category: string;
  shortDescription: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  popular?: boolean;
  benefits: Benefit[];
  modalTitle: string;
  modalHighlight?: {
    title: string;
    text: string;
  };
  modalSections: ModalSection[];
  modalNote: string;
  modalHelper?: {
    title: string;
    text: string;
  };
}

const {
  id,
  name,
  category,
  shortDescription,
  image,
  imageWidth,
  imageHeight,
  popular = false,
  benefits,
  modalTitle,
  modalHighlight,
  modalSections,
  modalNote,
  modalHelper,
} = Astro.props;

const modalId = `service-modal-${id}`;
const whatsappServiceUrl =
  "https://wa.me/573118735759?text=" +
  encodeURIComponent(
    `¡Hola Paula! Vengo de la página web de P.A.S y me interesa agendar o recibir información sobre: "${name}". ¿Qué disponibilidad tienes?`
  );
---

<article class="relative flex flex-col h-full bg-white rounded-3xl overflow-hidden border-2 border-purple-200/80 hover:border-teal-400 shadow-xs hover:shadow-xl transition-all duration-300 group">
  {popular && (
    <div class="absolute top-4 right-4 z-20 px-3.5 py-1 rounded-full bg-gradient-to-r from-purple-700 to-purple-900 text-white text-xs font-bold tracking-wider shadow-md">
      Recomendado
    </div>
  )}

  <!-- Service Image Container -->
  <div class="relative h-56 sm:h-64 overflow-hidden bg-slate-100">
    <img
      src={image}
      alt={`${name} en P.A.S Estética Holística Bogotá`}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
    <span class="absolute bottom-3 left-4 px-3 py-1 rounded-full bg-teal-600 text-white text-xs font-bold tracking-wide shadow-sm">
      {category}
    </span>
  </div>

  <!-- Content Body -->
  <div class="p-6 sm:p-7 flex flex-col flex-grow justify-between space-y-6">
    <div class="space-y-3.5">
      <!-- Title -->
      <div class="flex items-start justify-between gap-3">
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-purple-800 transition-colors leading-snug">
          {name}
        </h3>
      </div>

      <p class="text-sm text-slate-600 leading-relaxed">
        {shortDescription}
      </p>

      <!-- Benefits list -->
      <div class="pt-3 border-t border-slate-100">
        <p class="text-xs uppercase tracking-wider font-bold text-purple-900 mb-3">
          Lo que incluye y beneficios:
        </p>
        <ul class="space-y-2.5 text-xs text-slate-700 leading-relaxed">
          {benefits.map((benefit) => (
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-teal-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>
                <strong class="text-slate-900 font-semibold">{benefit.title}:</strong> {benefit.text}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Open Treatments Menu Modal Button -->
    <div class="pt-4 border-t border-purple-100">
      <button
        type="button"
        data-open-service-modal={modalId}
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl text-sm font-semibold text-white bg-purple-700 hover:bg-purple-800 active:bg-purple-900 shadow-sm hover:shadow-md transition-all duration-200 focus:outline-hidden focus:ring-2 focus:ring-purple-500 min-h-[46px] cursor-pointer"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        <span>Ver Tratamientos / Servicios</span>
      </button>
    </div>
  </div>
</article>

<!-- Native HTML5 <dialog> Modal for Service Treatments Menu (Baseline, 0 KB libraries) -->
<dialog
  id={modalId}
  aria-labelledby={`${modalId}-title`}
  class="service-menu-dialog m-auto w-[94%] max-w-3xl rounded-3xl p-0 bg-white text-slate-900 shadow-2xl border border-purple-200 overflow-hidden"
>
  <!-- Sticky Modal Header -->
  <div class="bg-gradient-to-r from-purple-950 via-purple-800 to-teal-800 px-5 sm:px-7 py-4 sm:py-5 flex items-center justify-between gap-4 text-white">
    <div class="space-y-0.5">
      <span class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-widest font-bold text-teal-200">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        {category} · P.A.S Estética Holística
      </span>
      <h3 id={`${modalId}-title`} class="font-serif text-lg sm:text-2xl font-bold leading-snug text-white">
        {modalTitle}
      </h3>
    </div>

    <button
      type="button"
      data-close-service-modal
      class="w-10 h-10 shrink-0 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition-colors focus:outline-hidden focus:ring-2 focus:ring-teal-300 cursor-pointer"
      aria-label={`Cerrar menú de ${name}`}
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Scrollable Modal Content -->
  <div class="max-h-[68vh] overflow-y-auto px-5 sm:px-7 py-6 space-y-7 bg-stone-50/60">
    
    {modalHighlight && (
      <div class="p-5 rounded-2xl bg-gradient-to-br from-purple-50 via-white to-teal-50/70 border border-purple-200 shadow-2xs space-y-2">
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-teal-100 text-teal-900 text-[11px] font-bold uppercase tracking-wider">
          Programa Destacado
        </span>
        <h4 class="font-serif text-lg sm:text-xl font-bold text-purple-950">
          {modalHighlight.title}
        </h4>
        <p class="text-sm text-slate-700 leading-relaxed">
          {modalHighlight.text}
        </p>
      </div>
    )}

    {modalSections.map((section) => (
      <div class="space-y-3.5">
        <div class="border-b border-purple-200/80 pb-2">
          <h4 class="font-serif text-lg sm:text-xl font-bold text-purple-950">
            {section.title}
          </h4>
          {section.subtitle && (
            <p class="text-xs sm:text-sm italic text-teal-800 mt-0.5">
              {section.subtitle}
            </p>
          )}
        </div>

        <ul class="grid grid-cols-1 gap-2.5">
          {section.items.map((item) => (
            <li class="p-3.5 sm:p-4 rounded-2xl bg-white border border-purple-100/90 hover:border-teal-300/80 transition-colors shadow-2xs">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="font-bold text-sm text-slate-900">
                  {item.name}
                </span>
                {item.badge && (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-800 border border-teal-200 text-[11px] font-bold">
                    {item.badge}
                  </span>
                )}
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Clinical Disclaimer Note -->
    <div class="p-4 rounded-2xl bg-purple-50/80 border border-purple-200/70 text-xs text-purple-950 italic leading-relaxed">
      {modalNote}
    </div>

    {modalHelper && (
      <div class="p-4 sm:p-5 rounded-2xl bg-teal-50/80 border border-teal-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="space-y-0.5">
          <p class="text-sm font-bold text-teal-950">{modalHelper.title}</p>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">{modalHelper.text}</p>
        </div>
      </div>
    )}

  </div>

  <!-- Sticky Modal Footer with WhatsApp Booking CTA -->
  <div class="bg-white border-t border-purple-100 px-5 sm:px-7 py-4 flex flex-col-reverse sm:flex-row items-center justify-between gap-3">
    <button
      type="button"
      data-close-service-modal
      class="w-full sm:w-auto px-6 py-3 rounded-full text-sm font-semibold text-slate-700 hover:text-purple-900 bg-stone-100 hover:bg-purple-50 border border-slate-200 transition-colors min-h-[46px] cursor-pointer"
    >
      Cerrar
    </button>

    <a
      href={whatsappServiceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3 rounded-full text-sm sm:text-base font-semibold text-white bg-purple-700 hover:bg-purple-800 active:bg-purple-900 shadow-md hover:shadow-lg transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-purple-300 min-h-[46px]"
    >
      <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>Agendar este Servicio</span>
    </a>
  </div>
</dialog>
