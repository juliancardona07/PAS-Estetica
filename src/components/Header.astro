---
const navLinks = [
  { label: "Inicio", href: "/#" },
  { label: "Servicios", href: "/#servicios" },
  { label: "Filosofía 360°", href: "/#filosofia" },
  { label: "Experiencia", href: "/#experiencia" },
  { label: "Políticas", href: "/#politicas" },
  { label: "Preguntas", href: "/#preguntas" },
  { label: "Contacto", href: "/#contacto" },
];

const whatsappUrl = "https://wa.me/573118735759?text=" + encodeURIComponent("Hola Paula, me gustaría recibir asesoría y agendar una cita en P.A.S Estética Holística.");
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-purple-100/70 shadow-xs transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-hidden focus:ring-2 focus:ring-purple-600 rounded-lg p-1" aria-label="P.A.S Estética Holística - Inicio">
        <div class="relative w-11 h-11 rounded-full bg-slate-900 flex items-center justify-center shadow-inner overflow-hidden border border-purple-200/40 group-hover:scale-105 transition-transform duration-200">
          <img 
            src="/images/logo-sm.webp" 
            alt="Logo P.A.S" 
            width="44" 
            height="44" 
            class="w-full h-full object-cover scale-125"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-wider text-slate-900 group-hover:text-purple-700 transition-colors">
            P.A.S
          </span>
          <span class="text-[10px] sm:text-xs uppercase tracking-widest text-purple-700 font-medium -mt-1">
            Estética Holística
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-7" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-700 hover:text-purple-700 transition-colors py-2 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-purple-600 hover:after:w-full after:transition-all after:duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop Header CTA -->
      <div class="hidden lg:flex items-center">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-purple-700 hover:bg-purple-800 active:bg-purple-900 shadow-sm hover:shadow transition-all duration-200 focus:outline-hidden focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 min-h-[44px]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Agendar Cita</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center">
        <button
          type="button"
          id="menu-toggle"
          class="inline-flex items-center justify-center p-2.5 rounded-lg text-slate-700 hover:text-purple-700 hover:bg-purple-50 focus:outline-hidden focus:ring-2 focus:ring-purple-600 min-w-[44px] min-h-[44px]"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <svg id="icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white/98 border-b border-purple-100 px-4 pt-3 pb-6 shadow-xl transition-all duration-300">
    <nav class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-base font-medium text-slate-700 hover:text-purple-700 hover:bg-purple-50 px-3 py-3 rounded-lg transition-colors min-h-[44px] flex items-center"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 mt-2 border-t border-purple-100">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full px-5 py-3 rounded-xl text-base font-semibold text-white bg-purple-700 hover:bg-purple-800 shadow-sm min-h-[48px]"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Agendar por WhatsApp</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Pure lightweight client script for mobile menu toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuToggle && mobileMenu && iconOpen && iconClose) {
    menuToggle.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close menu when a link is clicked
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
