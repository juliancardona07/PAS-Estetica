---
import servicesData from '../data/services.json';
import ServiceCard from './ServiceCard.astro';
---

<section id="servicios" class="py-20 sm:py-28 bg-gradient-to-b from-stone-50 via-teal-50/40 to-purple-50/50 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-teal-100 text-teal-900 border border-teal-300 text-xs uppercase tracking-widest font-bold">
        Carta de Tratamientos &amp; Servicios
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight">
        Protocolos diseñados para <span class="font-serif italic font-normal text-purple-800">renovar tu piel y calmar tu mente</span>
      </h2>
      <p class="text-base text-slate-600 leading-relaxed">
        Acompañamiento individualizado y protocolos a tu medida con el tiempo justo para que tu experiencia sea plena, respetuosa y sin afanes.
      </p>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 pt-4" id="category-filters">
        <button
          type="button"
          data-category="all"
          class="filter-btn active px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-colors duration-200 bg-purple-700 text-white min-h-[44px] cursor-pointer"
        >
          Todos los Servicios
        </button>
        <button
          type="button"
          data-category="Servicios 1"
          class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition-colors duration-200 bg-white text-slate-700 hover:bg-purple-100/70 border border-purple-200/80 min-h-[44px] cursor-pointer"
        >
          Servicios 1
        </button>
        <button
          type="button"
          data-category="Servicios 2"
          class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition-colors duration-200 bg-white text-slate-700 hover:bg-purple-100/70 border border-purple-200/80 min-h-[44px] cursor-pointer"
        >
          Servicios 2
        </button>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="services-grid">
      {servicesData.map((service) => (
        <div class="service-item transition-all duration-300" data-category={service.category}>
          <ServiceCard
            id={service.id}
            name={service.name}
            category={service.category}
            shortDescription={service.shortDescription}
            image={service.image}
            imageWidth={service.imageWidth}
            imageHeight={service.imageHeight}
            popular={service.popular}
            benefits={service.benefits}
            modalTitle={service.modalTitle}
            modalHighlight={service.modalHighlight}
            modalSections={service.modalSections}
            modalNote={service.modalNote}
            modalHelper={service.modalHelper}
          />
        </div>
      ))}
    </div>

    <!-- Diagnostic Consultation Banner -->
    <div class="mt-16 p-8 rounded-3xl bg-white border border-purple-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900">
          ¿Deseas una valoración diagnóstica personalizada?
        </h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Analizamos tu piel, tu cuerpo, tus hábitos y tus necesidades reales sin juicios ni fórmulas genéricas, antes de recomendarte cualquier protocolo, tratamiento o acompañamiento.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="https://wa.me/573118735759?text=Hola%20Paula,%20quisiera%20agendar%20una%20valoraci%C3%B3n%20inicial%20en%20P.A.S"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold text-white bg-purple-700 hover:bg-purple-800 transition-colors shadow-sm min-h-[44px]"
        >
          Agendar Valoración
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  // 1. Lightweight client filter for service categories
  const filterBtns = document.querySelectorAll('.filter-btn');
  const serviceItems = document.querySelectorAll('.service-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-purple-700', 'text-white');
        b.classList.add('bg-white', 'text-slate-700');
      });
      btn.classList.add('active', 'bg-purple-700', 'text-white');
      btn.classList.remove('bg-white', 'text-slate-700');

      const selectedCategory = btn.getAttribute('data-category');

      serviceItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (selectedCategory === 'all' || itemCategory === selectedCategory) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // 2. Native HTML5 <dialog> triggers & backdrop-click close
  const openModalButtons = document.querySelectorAll('[data-open-service-modal]');
  openModalButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-open-service-modal');
      if (!targetId) return;
      const dialog = document.getElementById(targetId) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  const serviceDialogs = document.querySelectorAll<HTMLDialogElement>('.service-menu-dialog');
  serviceDialogs.forEach((dialog) => {
    dialog.querySelectorAll('[data-close-service-modal]').forEach((closeBtn) => {
      closeBtn.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('click', (e: MouseEvent) => {
      const rect = dialog.getBoundingClientRect();
      const clickedInside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!clickedInside) {
        dialog.close();
      }
    });
  });
</script>
