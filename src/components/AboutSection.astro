---
const founderPhotos = [
  {
    src: "/images/founder-paula.webp",
    alt: "Paula Andrea Suárez - Fundadora y cosmetóloga holística en P.A.S Bogotá"
  },
  {
    src: "/images/founder-paula-2.webp",
    alt: "Paula Andrea Suárez revisando diagnóstico personalizado de bienestar en P.A.S"
  },
  {
    src: "/images/founder-paula-3.webp",
    alt: "Paula Andrea Suárez - Especialista en Estética Holística Integral Bogotá"
  }
];
---

<section id="nosotros" class="py-20 sm:py-28 bg-stone-50 overflow-hidden scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Founder Dynamic 3-Photo Showcase (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-sm lg:max-w-none" id="founder-carousel">
          <!-- Backing shadow / border accent -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-purple-300/40 via-purple-100 to-teal-100/50 -rotate-2 -z-10" aria-hidden="true"></div>
          
          <div class="relative overflow-hidden rounded-2xl bg-white shadow-xl border border-white aspect-4/5">
            {founderPhotos.map((photo, idx) => (
              <img
                src={photo.src}
                alt={photo.alt}
                width="600"
                height="750"
                loading={idx === 0 ? "eager" : "lazy"}
                decoding="async"
                data-founder-slide={idx}
                class={`founder-slide absolute inset-0 w-full h-full object-cover object-top transition-all duration-1000 ease-in-out ${
                  idx === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'
                }`}
              />
            ))}

            <!-- Subtle interactive slide indicators (bottom-left) -->
            <div class="absolute bottom-4 left-4 z-20 flex items-center gap-2 px-2.5 py-1.5 rounded-full bg-slate-900/45 backdrop-blur-md">
              {founderPhotos.map((_, idx) => (
                <button
                  type="button"
                  data-founder-dot={idx}
                  aria-label={`Ver foto ${idx + 1} de Paula Andrea Suárez`}
                  aria-current={idx === 0 ? "true" : "false"}
                  class={`founder-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${
                    idx === 0 ? 'w-6 bg-teal-300' : 'w-2 bg-white/70 hover:bg-white'
                  }`}
                />
              ))}
            </div>
          </div>

          <!-- Bottom floating badge -->
          <div class="absolute -bottom-6 -right-4 sm:right-6 z-20 bg-white p-4 rounded-2xl shadow-lg border border-purple-100 max-w-[240px]">
            <p class="font-serif text-sm font-bold text-slate-900">Paula Andrea Suárez</p>
            <p class="text-xs text-purple-700 font-medium">Fundadora &amp; Terapeuta Holística</p>
            <div class="flex items-center gap-1 mt-1 text-amber-500">
              <span>★★★★★</span>
              <span class="text-[10px] text-slate-500 font-semibold ml-1">Atención 1 a 1</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Text / Story Content (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100/80 text-purple-800 text-xs font-semibold uppercase tracking-wider">
          Quién está detrás de P.A.S
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight">
          Tu cuerpo es tu templo. Un espacio para desconectar tus sentidos y cuidarte desde <span class="font-serif italic font-normal text-purple-800">el corazón</span>.
        </h2>

        <div class="space-y-4 text-base text-slate-600 leading-relaxed">
          <p>
            ¡Hola! Soy <strong class="text-slate-900">Paula Andrea Suárez</strong>, cosmetóloga desde 2012. Creé <strong class="text-slate-900">P.A.S Estética Holística</strong> al darme cuenta de que quienes buscaban mejorar su piel, su peso y su bienestar llegaban cargados de estrés, tensiones y ritmos acelerados.
          </p>
          <p>
            A lo largo de estos años entendí que aplicar una técnica aislada sin escuchar a la persona, equilibrar su organismo ni calmar su sistema nervioso deja resultados cortos. Por eso uní la precisión de la <strong class="text-slate-900">aparatología estética, los protocolos faciales personalizados, las fórmulas magistrales, la homeopatía y los suplementos naturales</strong> con un trabajo corporal profundo: <strong class="text-slate-900">drenaje linfático manual, técnicas quiroprácticas e hipopresivos</strong> para desinflamar, armonizar el abdomen y acompañar procesos hacia el <strong class="text-slate-900">peso ideal</strong>, incluyendo casos de obesidad, con respeto y sin prisa.
          </p>
          <p>
            A este enfoque se suman mis <strong class="text-slate-900">cursos de autocuidado e hipopresivos</strong> y los <strong class="text-slate-900">círculos holísticos para mujeres y hombres</strong>, pensados para que cada persona siga cultivando su equilibrio más allá de la cabina.
          </p>
          <p>
            En P.A.S no hay juicios ni fórmulas genéricas. Te invito a <strong class="text-slate-900">desconectar tus sentidos</strong> y recordar que <strong class="text-slate-900">tu cuerpo es tu templo</strong>, acompañándote de forma cercana para cuidar tu piel, recuperar tu ligereza y habitar tu cuerpo con salud y calma desde adentro hacia afuera.
          </p>
        </div>

        <!-- Quote -->
        <blockquote class="p-4 sm:p-5 rounded-xl bg-purple-50/70 border-l-4 border-purple-600 text-sm italic text-purple-950">
          «La belleza no consiste en cambiar tus facciones ni en cumplir expectativas ajenas; consiste en permitir que tu luz, salud y bienestar interno se expresen en tu piel y en tu forma de habitar el mundo.»
        </blockquote>

      </div>

    </div>
  </div>
</section>

<script>
  function initFounderCarousel() {
    const carousel = document.getElementById('founder-carousel');
    if (!carousel) return;

    const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>('.founder-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.founder-dot'));
    if (slides.length < 2) return;

    let activeIndex = 0;
    let timerId: number | undefined;

    function showSlide(index: number) {
      activeIndex = index % slides.length;
      slides.forEach((slide, i) => {
        if (i === activeIndex) {
          slide.classList.remove('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'scale-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'scale-100', 'z-10');
          slide.classList.add('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((dot, i) => {
        if (i === activeIndex) {
          dot.classList.remove('w-2', 'bg-white/70');
          dot.classList.add('w-6', 'bg-teal-300');
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.classList.remove('w-6', 'bg-teal-300');
          dot.classList.add('w-2', 'bg-white/70');
          dot.setAttribute('aria-current', 'false');
        }
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      timerId = window.setInterval(() => {
        showSlide(activeIndex + 1);
      }, 4500);
    }

    function stopAutoPlay() {
      if (timerId !== undefined) {
        window.clearInterval(timerId);
        timerId = undefined;
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        showSlide(i);
        startAutoPlay();
      });
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);

    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFounderCarousel);
  } else {
    initFounderCarousel();
  }
</script>
