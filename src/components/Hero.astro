---
import BeforeAfterSlider from './BeforeAfterSlider.astro';

const whatsappHeroUrl = "https://wa.me/573118735759?text=" + encodeURIComponent("¡Hola Paula! Vengo de la página web de P.A.S y deseo agendar una valoración holística personalizada.");
---

<section class="relative overflow-hidden bg-stone-50 pt-8 pb-16 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-28 isolate">
  
  <!-- LAYER 1: Ambient Loop Video Background (Full Hero Section) -->
  <div class="absolute inset-0 -z-20 overflow-hidden pointer-events-none select-none" aria-hidden="true">
    <video
      id="hero-bg-video"
      class="w-full h-full object-cover object-center lg:object-[65%_center] scale-105 opacity-45 sm:opacity-55 blur-[1.5px] transition-opacity duration-700"
      poster="/images/hero-video-poster.webp"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      tabindex="-1"
    >
      <source data-src="/videos/hero-pas-loop.mp4" type="video/mp4" />
    </video>

    <!-- Editorial gradient veil ensuring WCAG 2.1 AA contrast on text while letting the video glow through -->
    <div class="absolute inset-0 bg-gradient-to-b from-stone-50/90 via-stone-50/82 to-stone-50/95 lg:bg-gradient-to-r lg:from-stone-50/94 lg:via-stone-50/80 lg:to-purple-50/55"></div>
    
    <!-- Soft radial aura accents matching the video's turquoise & lila ribbons -->
    <div class="absolute -top-12 right-1/4 w-96 h-96 rounded-full bg-purple-300/25 blur-3xl"></div>
    <div class="absolute bottom-4 left-10 w-80 h-80 rounded-full bg-teal-200/30 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- LEFT COLUMN: Text & CTA Content (7 cols) -->
      <div class="lg:col-span-7 space-y-5 sm:space-y-7 text-center lg:text-left bg-white/60 sm:bg-white/55 lg:bg-white/45 backdrop-blur-md rounded-3xl p-6 sm:p-8 lg:p-9 border border-white/80 shadow-[0_8px_32px_rgba(94,67,121,0.06)]">
        
        <!-- Category Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-100/95 border border-purple-200/80 text-purple-950 text-xs sm:text-sm font-medium tracking-wide shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
          Salud, Belleza & Bienestar Emocional en Bogotá
        </div>

        <!-- Main H1 -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.4rem] font-bold tracking-tight text-slate-900 leading-[1.13]">
          Tu refugio de pausa. <br class="hidden sm:inline" />
          <span class="font-serif italic font-normal text-purple-800">Belleza consciente</span> <br class="hidden sm:inline" />
          que sana desde el interior.
        </h1>

        <!-- Descriptive Paragraph from BRIEF -->
        <p class="text-base sm:text-lg text-slate-700 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Más que una cabina estética tradicional, <strong class="text-slate-900 font-semibold">P.A.S</strong> es un santuario diseñado para la desconexión total. Integramos protocolos de alta eficacia dérmica con aromaterapia y armonización energética, entendiendo que la verdadera belleza es el reflejo de tu equilibrio interno.
        </p>

        <!-- CTAs (Above the Fold optimized for Mobile & Social Traffic) -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 sm:gap-4 pt-1">
          <a
            href={whatsappHeroUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full text-base font-semibold text-white bg-purple-700 hover:bg-purple-800 active:bg-purple-900 shadow-md hover:shadow-lg transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-purple-300 min-h-[48px]"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Agendar Cita en WhatsApp</span>
          </a>

          <a
            href="#servicios"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-full text-base font-medium text-purple-950 bg-white/95 hover:bg-purple-50 border border-purple-200/90 transition-colors shadow-xs min-h-[48px]"
          >
            Explorar Tratamientos
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="pt-5 border-t border-purple-200/70 grid grid-cols-3 gap-4 text-left">
          <div>
            <p class="font-serif text-xl sm:text-2xl font-bold text-purple-900">360°</p>
            <p class="text-xs text-slate-700 mt-0.5 font-medium">Cuerpo, mente y energía</p>
          </div>
          <div>
            <p class="font-serif text-xl sm:text-2xl font-bold text-purple-900">1 a 1</p>
            <p class="text-xs text-slate-700 mt-0.5 font-medium">Espacio privado sin prisas</p>
          </div>
          <div>
            <p class="font-serif text-xl sm:text-2xl font-bold text-purple-900">100%</p>
            <p class="text-xs text-slate-700 mt-0.5 font-medium">Personalizado a tu piel</p>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Dual Showcase (Crisp Brand Loop Video + Interactive Before/After) (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Ambient frame border with purple & mint gradient -->
          <div class="absolute -inset-3.5 rounded-3xl bg-gradient-to-tr from-purple-400/35 via-teal-300/35 to-purple-200/45 blur-md -z-10" aria-hidden="true"></div>

          <!-- Showcase Mode Switcher Pills -->
          <div
            class="mb-3 p-1.5 rounded-2xl bg-white/90 backdrop-blur-md border border-purple-200/80 shadow-sm grid grid-cols-2 gap-1.5"
            role="tablist"
            aria-label="Selector de vista destacada"
          >
            <button
              type="button"
              id="tab-btn-video"
              role="tab"
              aria-selected="true"
              aria-controls="panel-brand-video"
              class="flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-purple-700 text-white shadow-xs cursor-pointer min-h-[40px]"
            >
              <span class="w-2 h-2 rounded-full bg-teal-300 animate-ping"></span>
              <span>Esencia P.A.S</span>
            </button>
            <button
              type="button"
              id="tab-btn-results"
              role="tab"
              aria-selected="false"
              aria-controls="panel-before-after"
              class="flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-700 hover:text-purple-900 hover:bg-purple-50/80 cursor-pointer min-h-[40px]"
            >
              <svg class="w-4 h-4 text-teal-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              <span>Antes / Después</span>
            </button>
          </div>

          <!-- PANEL 1: Crisp 16:9 Brand Reveal Loop Video Showcase (Uncropped for Mobile & Desktop) -->
          <div
            id="panel-brand-video"
            role="tabpanel"
            aria-labelledby="tab-btn-video"
            class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-white transition-all duration-300"
          >
            <!-- Top Header Bar -->
            <div class="bg-gradient-to-r from-purple-900 via-purple-800 to-teal-800 px-4 py-2.5 flex items-center justify-between text-white text-xs">
              <span class="font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
                Santuario de Estética Holística Integral
              </span>
              <span class="text-[11px] text-purple-200 font-medium">
                Armonía & Piel
              </span>
            </div>

            <!-- 16:9 Uncropped Video Frame -->
            <div class="relative w-full aspect-video bg-[#EAE5DC] overflow-hidden">
              <video
                id="hero-showcase-video"
                class="w-full h-full object-contain"
                poster="/images/hero-video-poster.webp"
                width="1280"
                height="720"
                muted
                loop
                playsinline
                webkit-playsinline
                preload="metadata"
              >
                <source data-src="/videos/hero-pas-loop.mp4" type="video/mp4" />
              </video>

              <!-- Accessible Play/Pause Control Button (WCAG 2.2.2 compliant) -->
              <button
                type="button"
                id="hero-video-toggle"
                class="absolute bottom-3 right-3 z-20 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900/75 hover:bg-slate-900 text-white text-[11px] font-medium backdrop-blur-md transition-colors cursor-pointer min-h-[36px]"
                aria-label="Pausar animación de video"
                title="Pausar o reproducir video"
              >
                <svg id="icon-video-pause" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
                <svg id="icon-video-play" class="w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <span id="label-video-toggle">Pausar</span>
              </button>
            </div>

            <!-- Bottom Holistic Pillars Bar -->
            <div class="px-4 py-3.5 bg-stone-50 border-t border-purple-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-700">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-100/90 text-purple-900 font-semibold text-[11px]">
                  ✨ Estética Consciente
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-teal-50 text-teal-800 border border-teal-200/80 font-semibold text-[11px]">
                  🌿 Calma & Energía
                </span>
              </div>
              <button
                type="button"
                id="cta-switch-to-results"
                class="text-purple-800 hover:text-purple-950 font-bold underline underline-offset-2 text-[11px] cursor-pointer"
              >
                Ver casos reales →
              </button>
            </div>
          </div>

          <!-- PANEL 2: Interactive Before/After Slider -->
          <div
            id="panel-before-after"
            role="tabpanel"
            aria-labelledby="tab-btn-results"
            class="hidden transition-all duration-300"
          >
            <BeforeAfterSlider />
          </div>

          <!-- Location & Exclusivity badge below showcase -->
          <div class="mt-3.5 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md border border-purple-200/90 shadow-md flex items-center justify-between text-xs text-slate-700">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-bold text-slate-900">Atención Exclusiva en Bogotá</span>
            </div>
            <span class="text-purple-800 font-semibold text-[11px]">
              Carrera 53A #127 · Cita previa
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initHeroExperience() {
    const bgVideo = document.getElementById('hero-bg-video') as HTMLVideoElement | null;
    const showcaseVideo = document.getElementById('hero-showcase-video') as HTMLVideoElement | null;
    const toggleBtn = document.getElementById('hero-video-toggle') as HTMLButtonElement | null;
    const iconPause = document.getElementById('icon-video-pause');
    const iconPlay = document.getElementById('icon-video-play');
    const labelToggle = document.getElementById('label-video-toggle');

    const tabVideo = document.getElementById('tab-btn-video') as HTMLButtonElement | null;
    const tabResults = document.getElementById('tab-btn-results') as HTMLButtonElement | null;
    const ctaSwitchResults = document.getElementById('cta-switch-to-results') as HTMLButtonElement | null;
    const panelVideo = document.getElementById('panel-brand-video');
    const panelResults = document.getElementById('panel-before-after');

    const videos = [bgVideo, showcaseVideo].filter((v): v is HTMLVideoElement => v !== null);

    // Check accessibility & data-saver preferences
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = (navigator as unknown as { connection?: { saveData?: boolean } }).connection;
    const saveData = Boolean(connection?.saveData);

    function setToggleUI(isPaused: boolean) {
      if (!toggleBtn || !iconPause || !iconPlay || !labelToggle) return;
      if (isPaused) {
        iconPause.classList.add('hidden');
        iconPlay.classList.remove('hidden');
        labelToggle.textContent = 'Reproducir';
        toggleBtn.setAttribute('aria-label', 'Reproducir animación de video');
      } else {
        iconPause.classList.remove('hidden');
        iconPlay.classList.add('hidden');
        labelToggle.textContent = 'Pausar';
        toggleBtn.setAttribute('aria-label', 'Pausar animación de video');
      }
    }

    function hydrateAndPlayVideos() {
      videos.forEach((video) => {
        // Ensure muted & inline flags for Instagram / TikTok / WhatsApp In-App Browsers
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;

        const source = video.querySelector('source');
        if (source && source.dataset.src && !source.getAttribute('src')) {
          source.setAttribute('src', source.dataset.src);
          video.load();
        }

        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => setToggleUI(false))
            .catch(() => setToggleUI(true));
        }
      });
    }

    if (!prefersReducedMotion && !saveData) {
      // Defer video stream start until after initial paint so LCP is 0ms blocked
      if ('requestIdleCallback' in window) {
        (window as Window & { requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void })
          .requestIdleCallback(hydrateAndPlayVideos, { timeout: 800 });
      } else {
        setTimeout(hydrateAndPlayVideos, 150);
      }
    } else {
      setToggleUI(true);
    }

    // Play / Pause accessible toggle button
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const anyPlaying = videos.some((v) => !v.paused);
        if (anyPlaying) {
          videos.forEach((v) => v.pause());
          setToggleUI(true);
        } else {
          hydrateAndPlayVideos();
          setToggleUI(false);
        }
      });
    }

    // Showcase Tabs switching (Esencia P.A.S Video <-> Antes/Después Slider)
    function activateTab(mode: 'video' | 'results') {
      if (!tabVideo || !tabResults || !panelVideo || !panelResults) return;

      if (mode === 'video') {
        tabVideo.setAttribute('aria-selected', 'true');
        tabVideo.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-purple-700 text-white shadow-xs cursor-pointer min-h-[40px]';
        tabResults.setAttribute('aria-selected', 'false');
        tabResults.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-700 hover:text-purple-900 hover:bg-purple-50/80 cursor-pointer min-h-[40px]';
        panelVideo.classList.remove('hidden');
        panelResults.classList.add('hidden');
      } else {
        tabResults.setAttribute('aria-selected', 'true');
        tabResults.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-purple-700 text-white shadow-xs cursor-pointer min-h-[40px]';
        tabVideo.setAttribute('aria-selected', 'false');
        tabVideo.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-700 hover:text-purple-900 hover:bg-purple-50/80 cursor-pointer min-h-[40px]';
        panelResults.classList.remove('hidden');
        panelVideo.classList.add('hidden');
        // Trigger resize so BeforeAfterSlider recalculates container width immediately
        window.dispatchEvent(new Event('resize'));
      }
    }

    tabVideo?.addEventListener('click', () => activateTab('video'));
    tabResults?.addEventListener('click', () => activateTab('results'));
    ctaSwitchResults?.addEventListener('click', () => activateTab('results'));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroExperience);
  } else {
    initHeroExperience();
  }
</script>
