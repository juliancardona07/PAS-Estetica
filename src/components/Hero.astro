---
const whatsappBase = "https://wa.me/573118735759?text=";
const whatsappCorporalUrl = whatsappBase + encodeURIComponent("¡Hola Paula! Vi los resultados de Moldeo Corporal en la web de P.A.S y deseo agendar una valoración personalizada.");
const whatsappFacialUrl = whatsappBase + encodeURIComponent("¡Hola Paula! Vi los resultados Faciales en la web de P.A.S y deseo agendar una valoración personalizada.");
---

<section id="inicio" class="relative min-h-[80vh] flex items-center overflow-hidden bg-[#1F142C] text-white isolate scroll-mt-24">
  
  <!-- LAYER 1: Full-Bleed Panoramic HD Sanctuary Photography with Cinematic Ken Burns Zoom + Pan -->
  <div class="absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <img
      src="/images/hero-sanctuary-hd.webp"
      alt="Cabina privada de spa holístico P.A.S con velas cálidas, aceites botánicos y toallas en tonos lila y verde menta"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="w-full h-full object-cover object-[72%_center] lg:object-center animate-hero-kenburns"
    />
  </div>

  <!-- LAYER 2: Responsive Editorial Atmospheric Veil (Lighter on mobile so candles & towels shine, balanced on desktop) -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-[#1D112B]/68 via-[#261638]/42 to-[#122B29]/72 lg:bg-gradient-to-r lg:from-[#1D112B]/80 lg:via-[#2A193C]/58 lg:to-[#122B29]/62 pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-[#1A1026]/35 via-transparent to-[#150E20]/55 pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- LAYER 3: Asymmetric Full-Bleed Composition (Editorial Copy + Visible Interactive Before/After) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-28 sm:pt-16 sm:pb-32 lg:pt-20 lg:pb-36">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-10 items-center">
      
      <!-- LEFT COLUMN: Editorial Headline, Pillars & CTA (6 cols) -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
        
        <!-- Location & Concept Pill -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/12 backdrop-blur-md border border-white/25 text-teal-200 text-xs sm:text-sm font-semibold tracking-wider uppercase shadow-sm">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          <span>Salud, Belleza &amp; Bienestar Emocional · Bogotá</span>
        </div>

        <!-- Main Editorial H1 -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-bold tracking-tight text-white leading-[1.12] drop-shadow-xs">
          Tu refugio de pausa. <br class="hidden sm:inline" />
          <span class="font-serif italic font-normal text-teal-200">Belleza consciente</span> <br class="hidden sm:inline" />
          que sana desde el interior.
        </h1>

        <!-- Concise Sanctuary Narrative -->
        <p class="text-base sm:text-lg text-purple-50/90 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Más que una cabina estética tradicional, <strong class="text-white font-semibold">P.A.S</strong> es un santuario privado donde unimos protocolos de alta eficacia dérmica con aromaterapia y armonización energética.
        </p>

        <!-- Frosted Glass Pillars Strip -->
        <div class="grid grid-cols-3 gap-2.5 sm:gap-4 p-3.5 sm:p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 shadow-lg max-w-xl mx-auto lg:mx-0">
          <div class="px-1 text-center lg:text-left">
            <p class="font-serif text-xl sm:text-2xl font-bold text-teal-200">360°</p>
            <p class="text-xs text-purple-100/90 mt-0.5">Cuerpo, mente y energía</p>
          </div>
          <div class="px-2 text-center lg:text-left border-x border-white/15">
            <p class="font-serif text-xl sm:text-2xl font-bold text-teal-200">1 a 1</p>
            <p class="text-xs text-purple-100/90 mt-0.5">Cabina privada sin prisas</p>
          </div>
          <div class="px-1 text-center lg:text-left">
            <p class="font-serif text-xl sm:text-2xl font-bold text-teal-200">100%</p>
            <p class="text-xs text-purple-100/90 mt-0.5">Personalizado a tu piel</p>
          </div>
        </div>

        <!-- Secondary CTA + Location -->
        <div class="pt-1 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#servicios"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-bold text-purple-950 bg-white hover:bg-purple-50 shadow-lg transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-teal-300/70 min-h-[48px]"
          >
            <span>Explorar Tratamientos</span>
            <span aria-hidden="true">↓</span>
          </a>

          <p class="text-xs sm:text-sm text-purple-100/85 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
            <span>Carrera 53A #127 · Cita previa</span>
          </p>
        </div>

      </div>

      <!-- RIGHT COLUMN: Always-Visible Frosted Glass Before/After Comparator (Corporal & Facial) (6 cols) -->
      <div class="lg:col-span-6">
        <div class="relative mx-auto max-w-lg lg:max-w-none rounded-3xl p-3 sm:p-4 bg-white/14 backdrop-blur-xl border border-white/25 shadow-[0_24px_60px_rgba(0,0,0,0.42)]">
          
          <!-- Header & Direct Tabs: Corporal vs Facial -->
          <div class="mb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <div class="flex items-center gap-2 px-1">
              <span class="w-2.5 h-2.5 rounded-full bg-teal-400 animate-pulse shrink-0"></span>
              <h2 class="text-xs sm:text-sm font-bold tracking-wide text-white uppercase">
                Resultados Reales
              </h2>
            </div>

            <div
              class="p-1 rounded-xl bg-black/25 border border-white/15 grid grid-cols-2 gap-1"
              role="tablist"
              aria-label="Seleccionar tipo de resultado antes y después"
            >
              <button
                type="button"
                id="hero-tab-corporal"
                role="tab"
                aria-selected="true"
                class="py-1.5 px-3 rounded-lg text-xs font-bold transition-all bg-white text-purple-950 shadow-xs cursor-pointer min-h-[36px]"
              >
                🌿 Corporal
              </button>
              <button
                type="button"
                id="hero-tab-facial"
                role="tab"
                aria-selected="false"
                class="py-1.5 px-3 rounded-lg text-xs font-semibold transition-all text-purple-100 hover:bg-white/10 cursor-pointer min-h-[36px]"
              >
                ✨ Facial
              </button>
            </div>
          </div>

          <!-- Interactive Before / After Slider -->
          <div
            id="hero-ba-container"
            role="slider"
            tabindex="0"
            aria-label="Deslizador de comparación antes y después"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            class="relative w-full aspect-4/3 rounded-2xl overflow-hidden cursor-ew-resize touch-none select-none border-2 border-white/80 shadow-lg focus-visible:outline-2 focus-visible:outline-teal-300 bg-stone-900"
          >
            <!-- AFTER Image -->
            <img
              id="hero-after-img"
              src="/images/abdomen-despues.webp"
              alt="Abdomen después de sesión de moldeo corporal y reducción en P.A.S"
              width="640"
              height="520"
              loading="eager"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover pointer-events-none"
            />
            <div class="absolute top-3 right-3 z-10 px-3 py-1 rounded-full bg-teal-600/90 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider shadow-md pointer-events-none">
              Después
            </div>

            <!-- BEFORE Image (Clipped Overlay) -->
            <div id="hero-before-layer" class="absolute inset-y-0 left-0 overflow-hidden w-1/2 pointer-events-none will-change-[width]">
              <img
                id="hero-before-img"
                src="/images/abdomen-antes.webp"
                alt="Abdomen antes de sesión de moldeo corporal y reducción en P.A.S"
                width="640"
                height="520"
                loading="eager"
                decoding="async"
                class="absolute inset-y-0 left-0 w-full h-full object-cover max-w-none"
              />
              <div class="absolute top-3 left-3 z-10 px-3 py-1 rounded-full bg-purple-900/90 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider shadow-md pointer-events-none">
                Antes
              </div>
            </div>

            <!-- Draggable Divider Handle -->
            <div id="hero-slider-handle" class="absolute inset-y-0 left-1/2 -ml-0.5 w-1 bg-white shadow-2xl pointer-events-none will-change-[left]">
              <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-11 h-11 rounded-full bg-gradient-to-r from-purple-700 to-teal-600 text-white shadow-xl flex items-center justify-center border-2 border-white ring-4 ring-purple-300/40">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8.5 7l-5 5 5 5V7zm7 10l5-5-5-5v10z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Footer Bar inside Glass Card -->
          <div class="mt-3 px-1 flex flex-col sm:flex-row items-center justify-between gap-2.5">
            <p id="hero-case-caption" class="text-xs text-purple-100/95 text-center sm:text-left">
              Desliza para comparar · <strong class="text-white">Moldeo Corporal &amp; Reducción</strong>
            </p>
            <a
              id="hero-case-whatsapp"
              href={whatsappCorporalUrl}
              data-corporal-url={whatsappCorporalUrl}
              data-facial-url={whatsappFacialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-xs transition-colors shadow-sm min-h-[38px]"
            >
              <span>Quiero este resultado</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Graceful Layered Organic Wave Transition into next section (stone-50) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-[-1px] z-10 overflow-hidden leading-none" aria-hidden="true">
    <svg
      class="relative block w-full h-14 sm:h-20 lg:h-24"
      viewBox="0 0 1440 100"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,100 L0,18 C420,98 1020,98 1440,18 L1440,100 Z"
        fill="#D2BEE3"
        fill-opacity="0.32"
      />
      <path
        d="M0,100 L0,36 C420,104 1020,104 1440,36 L1440,100 Z"
        fill="#FAFAF9"
      />
    </svg>
  </div>
</section>

<script>
  function initHeroComparator() {
    const tabCorporal = document.getElementById('hero-tab-corporal');
    const tabFacial = document.getElementById('hero-tab-facial');

    const container = document.getElementById('hero-ba-container');
    const beforeLayer = document.getElementById('hero-before-layer') as HTMLElement | null;
    const beforeImg = document.getElementById('hero-before-img') as HTMLImageElement | null;
    const afterImg = document.getElementById('hero-after-img') as HTMLImageElement | null;
    const handle = document.getElementById('hero-slider-handle') as HTMLElement | null;
    const caption = document.getElementById('hero-case-caption');
    const whatsappCta = document.getElementById('hero-case-whatsapp') as HTMLAnchorElement | null;

    if (!container || !beforeLayer || !beforeImg || !afterImg || !handle) return;

    let isInteracting = false;
    let currentPercent = 50;
    let containerRect = container.getBoundingClientRect();

    function syncBeforeImageWidth() {
      if (!container || !beforeImg) return;
      containerRect = container.getBoundingClientRect();
      if (containerRect.width > 0) {
        beforeImg.style.width = `${containerRect.width}px`;
      }
    }

    function applyPercent(percent: number) {
      if (!container || !beforeLayer || !handle) return;
      currentPercent = Math.max(0, Math.min(100, percent));
      container.setAttribute('aria-valuenow', String(Math.round(currentPercent)));
      requestAnimationFrame(() => {
        beforeLayer.style.width = `${currentPercent}%`;
        handle.style.left = `${currentPercent}%`;
      });
    }

    function setPosition(clientX: number) {
      if (!container) return;
      if (!containerRect || containerRect.width === 0) {
        syncBeforeImageWidth();
      }
      const x = clientX - containerRect.left;
      applyPercent((x / containerRect.width) * 100);
    }

    window.addEventListener('resize', syncBeforeImageWidth);
    syncBeforeImageWidth();

    container.addEventListener('pointerdown', (e: PointerEvent) => {
      isInteracting = true;
      container.setPointerCapture(e.pointerId);
      setPosition(e.clientX);
    });

    container.addEventListener('pointermove', (e: PointerEvent) => {
      if (e.pointerType === 'mouse' || isInteracting) {
        setPosition(e.clientX);
      }
    });

    const endInteraction = (e: PointerEvent) => {
      isInteracting = false;
      try {
        container.releasePointerCapture(e.pointerId);
      } catch (_) {}
    };

    container.addEventListener('pointerup', endInteraction);
    container.addEventListener('pointercancel', endInteraction);

    container.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length > 0) setPosition(e.touches[0].clientX);
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length > 0) setPosition(e.touches[0].clientX);
    }, { passive: true });

    container.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        applyPercent(currentPercent - 5);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        applyPercent(currentPercent + 5);
      } else if (e.key === 'Home') {
        e.preventDefault();
        applyPercent(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        applyPercent(100);
      }
    });

    function selectCase(mode: 'corporal' | 'facial') {
      if (!tabCorporal || !tabFacial || !beforeImg || !afterImg || !caption || !whatsappCta) return;

      const activeClass = 'py-1.5 px-3 rounded-lg text-xs font-bold transition-all bg-white text-purple-950 shadow-xs cursor-pointer min-h-[36px]';
      const inactiveClass = 'py-1.5 px-3 rounded-lg text-xs font-semibold transition-all text-purple-100 hover:bg-white/10 cursor-pointer min-h-[36px]';

      if (mode === 'corporal') {
        tabCorporal.setAttribute('aria-selected', 'true');
        tabCorporal.className = activeClass;
        tabFacial.setAttribute('aria-selected', 'false');
        tabFacial.className = inactiveClass;

        beforeImg.src = '/images/abdomen-antes.webp';
        beforeImg.alt = 'Abdomen antes de sesión de moldeo corporal y reducción en P.A.S';
        afterImg.src = '/images/abdomen-despues.webp';
        afterImg.alt = 'Abdomen después de sesión de moldeo corporal y reducción en P.A.S';

        caption.textContent = 'Desliza para comparar · Moldeo Corporal & Reducción';
        whatsappCta.href = whatsappCta.dataset.corporalUrl || whatsappCta.href;
      } else {
        tabFacial.setAttribute('aria-selected', 'true');
        tabFacial.className = activeClass;
        tabCorporal.setAttribute('aria-selected', 'false');
        tabCorporal.className = inactiveClass;

        beforeImg.src = '/images/facial-antes.webp';
        beforeImg.alt = 'Rostro antes de tratamiento facial holístico en P.A.S';
        afterImg.src = '/images/facial-despues.webp';
        afterImg.alt = 'Rostro después de tratamiento facial holístico en P.A.S';

        caption.textContent = 'Desliza para comparar · Estética Facial Holística';
        whatsappCta.href = whatsappCta.dataset.facialUrl || whatsappCta.href;
      }

      syncBeforeImageWidth();
      applyPercent(50);
    }

    tabCorporal?.addEventListener('click', () => selectCase('corporal'));
    tabFacial?.addEventListener('click', () => selectCase('facial'));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroComparator);
  } else {
    initHeroComparator();
  }
</script>
