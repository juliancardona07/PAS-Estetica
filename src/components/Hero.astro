---
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import SectionDivider from './SectionDivider.astro';
---

<!-- =====================================================================
     MOMENTO 1: HERO CINEMÁTICO INTEGRADO
     El video se funde orgánicamente con el lienzo luminoso de la página,
     sin recuadros duros ni fondos oscuros.
     ===================================================================== -->
<section class="relative bg-stone-50 overflow-hidden isolate pt-2 sm:pt-4">
  
  <!-- Soft ambient aura behind the integrated video -->
  <div class="absolute top-0 left-1/4 w-[28rem] h-[28rem] rounded-full bg-purple-200/35 blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute bottom-10 right-1/4 w-[28rem] h-[28rem] rounded-full bg-teal-200/30 blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

  <!-- Seamless Integrated Video Canvas (No Box, Feathered Edges into stone-50) -->
  <div class="relative w-full max-w-[1600px] mx-auto">
    
    <!-- Subtle accessible Play/Pause pill in top-right corner -->
    <div class="absolute top-2 sm:top-4 right-4 sm:right-8 z-20">
      <button
        type="button"
        id="hero-video-toggle"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/75 hover:bg-white text-slate-700 border border-purple-200/60 text-[11px] font-medium backdrop-blur-md shadow-2xs transition-all cursor-pointer min-h-[34px]"
        aria-label="Pausar animación de video"
        title="Pausar o reproducir video"
      >
        <svg id="icon-video-pause" class="w-3 h-3 fill-current text-purple-700" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
        <svg id="icon-video-play" class="w-3 h-3 fill-current text-purple-700 hidden" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span id="label-video-toggle">Pausar</span>
      </button>
    </div>

    <!-- Feathered & Tone-Matched Video Layer -->
    <div class="relative w-full aspect-16/10 sm:aspect-16/9 lg:aspect-21/9 max-h-[72vh] min-h-[260px] sm:min-h-[420px] flex items-center justify-center overflow-hidden">
      <video
        id="hero-main-video"
        class="w-full h-full object-contain sm:object-cover object-center brightness-[1.07] contrast-[1.02] saturate-[1.08] [mask-image:radial-gradient(ellipse_88%_82%_at_50%_48%,#000_62%,transparent_100%)] transition-opacity duration-700"
        poster="/images/hero-video-poster.webp"
        width="1280"
        height="720"
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
      >
        <source data-src="/videos/hero-pas-loop.mp4" type="video/mp4" />
      </video>

      <!-- Seamless edge dissolves into stone-50 so no box/rectangle is ever visible -->
      <div class="absolute inset-x-0 top-0 h-12 sm:h-20 bg-gradient-to-b from-stone-50 via-stone-50/40 to-transparent pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-20 sm:h-32 bg-gradient-to-t from-stone-50 via-stone-50/70 to-transparent pointer-events-none" aria-hidden="true"></div>
      <div class="hidden sm:block absolute inset-y-0 left-0 w-24 lg:w-40 bg-gradient-to-r from-stone-50 via-stone-50/50 to-transparent pointer-events-none" aria-hidden="true"></div>
      <div class="hidden sm:block absolute inset-y-0 right-0 w-24 lg:w-40 bg-gradient-to-l from-stone-50 via-stone-50/50 to-transparent pointer-events-none" aria-hidden="true"></div>
    </div>

  </div>

  <!-- Centered Headline Card (Buttons Removed per user request) -->
  <div class="relative z-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-12 pb-8 sm:pb-12">
    <div class="rounded-3xl bg-white/85 backdrop-blur-xl border border-purple-200/70 shadow-[0_12px_40px_rgba(94,67,121,0.08)] px-6 py-6 sm:px-10 sm:py-8 text-center space-y-2">
      <p class="text-xs sm:text-sm font-bold uppercase tracking-widest text-teal-700">
        Salud, Belleza & Bienestar Emocional
      </p>
      <h1 class="text-2xl sm:text-4xl lg:text-[2.65rem] font-bold tracking-tight text-slate-900 leading-tight">
        Tu refugio de pausa. <span class="font-serif italic font-normal text-purple-800">Belleza consciente</span> que sana desde el interior.
      </h1>
    </div>
  </div>
</section>

<!-- Divider with P.A.S Lotus Flower -->
<SectionDivider />

<!-- =====================================================================
     MOMENTO 2: SECCIÓN EDITORIAL — EL SANTUARIO & RESULTADOS REALES
     ===================================================================== -->
<section id="esencia-y-resultados" class="relative py-16 sm:py-24 bg-gradient-to-b from-stone-50 via-purple-50/35 to-stone-50 overflow-hidden scroll-mt-20">
  
  <!-- Decorative soft blurs -->
  <div class="absolute top-12 right-10 -z-10 w-80 h-80 rounded-full bg-purple-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-10 -z-10 w-80 h-80 rounded-full bg-teal-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      
      <!-- Narrative & Bento Pillars (6 cols) -->
      <div class="lg:col-span-6 space-y-6 sm:space-y-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-900 text-xs uppercase tracking-widest font-bold">
          Ciencia Dérmica & Armonía Interior
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.15]">
          Un santuario diseñado para la <span class="font-serif italic font-normal text-purple-800">desconexión total</span> y resultados visibles.
        </h2>

        <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
          Más que una cabina estética tradicional, <strong class="text-slate-900 font-semibold">P.A.S</strong> integra protocolos clínicos no invasivos de alta eficacia con aromaterapia y armonización energética. Aquí no vienes con prisa: cada sesión renueva tu piel mientras libera el estrés acumulado en tu cuerpo.
        </p>

        <!-- Bento Trust Cards (3 Pillars) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              360°
            </span>
            <h3 class="text-sm font-bold text-slate-900">Enfoque Integral</h3>
            <p class="text-xs text-slate-600 mt-0.5">Cuerpo, mente y energía en sintonía</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-teal-200/80 shadow-xs hover:shadow-md hover:border-teal-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-teal-50 text-teal-800 font-serif font-bold text-lg mb-2">
              1:1
            </span>
            <h3 class="text-sm font-bold text-slate-900">Sin Prisas</h3>
            <p class="text-xs text-slate-600 mt-0.5">Cabina privada exclusiva para ti</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              100%
            </span>
            <h3 class="text-sm font-bold text-slate-900">A tu Medida</h3>
            <p class="text-xs text-slate-600 mt-0.5">Diagnóstico previo personalizado</p>
          </div>
        </div>

        <!-- Secondary link to catalog -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="#servicios"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-purple-900 bg-white hover:bg-purple-50 border-2 border-purple-200 shadow-xs transition-all min-h-[48px]"
          >
            <span>Explorar Catálogo de Tratamientos</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Interactive Before/After Showcase (6 cols) -->
      <div class="lg:col-span-6 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Ambient frame border with purple & mint gradient -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-purple-400/30 via-teal-300/30 to-purple-200/40 blur-md -z-10" aria-hidden="true"></div>
          
          <BeforeAfterSlider />

          <!-- Location & Exclusivity badge below slider -->
          <div class="mt-4 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md border border-purple-200 shadow-md flex items-center justify-between text-xs text-slate-700">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-bold text-slate-900">Atención Exclusiva en Bogotá</span>
            </div>
            <span class="text-purple-800 font-semibold text-[11px]">
              Carrera 53A #127 · Cita previa
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initHeroVideo() {
    const mainVideo = document.getElementById('hero-main-video') as HTMLVideoElement | null;
    const toggleBtn = document.getElementById('hero-video-toggle') as HTMLButtonElement | null;
    const iconPause = document.getElementById('icon-video-pause');
    const iconPlay = document.getElementById('icon-video-play');
    const labelToggle = document.getElementById('label-video-toggle');

    if (!mainVideo) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = (navigator as unknown as { connection?: { saveData?: boolean } }).connection;
    const saveData = Boolean(connection?.saveData);

    function setToggleUI(isPaused: boolean) {
      if (!toggleBtn || !iconPause || !iconPlay || !labelToggle) return;
      if (isPaused) {
        iconPause.classList.add('hidden');
        iconPlay.classList.remove('hidden');
        labelToggle.textContent = 'Reproducir';
        toggleBtn.setAttribute('aria-label', 'Reproducir animación de video');
      } else {
        iconPause.classList.remove('hidden');
        iconPlay.classList.add('hidden');
        labelToggle.textContent = 'Pausar';
        toggleBtn.setAttribute('aria-label', 'Pausar animación de video');
      }
    }

    function hydrateAndPlay() {
      if (!mainVideo) return;
      mainVideo.muted = true;
      mainVideo.defaultMuted = true;
      mainVideo.playsInline = true;

      const source = mainVideo.querySelector('source');
      if (source && source.dataset.src && !source.getAttribute('src')) {
        source.setAttribute('src', source.dataset.src);
        mainVideo.load();
      }

      const playPromise = mainVideo.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => setToggleUI(false))
          .catch(() => setToggleUI(true));
      }
    }

    if (!prefersReducedMotion && !saveData) {
      if ('requestIdleCallback' in window) {
        (window as Window & { requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void })
          .requestIdleCallback(hydrateAndPlay, { timeout: 600 });
      } else {
        setTimeout(hydrateAndPlay, 100);
      }
    } else {
      setToggleUI(true);
    }

    toggleBtn?.addEventListener('click', () => {
      if (!mainVideo.paused) {
        mainVideo.pause();
        setToggleUI(true);
      } else {
        hydrateAndPlay();
        setToggleUI(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>
