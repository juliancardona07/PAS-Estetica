---
import BeforeAfterSlider from './BeforeAfterSlider.astro';

const whatsappHeroUrl = "https://wa.me/573118735759?text=" + encodeURIComponent("¡Hola Paula! Vengo de la página web de P.A.S y deseo agendar una valoración holística personalizada.");
---

<!-- =====================================================================
     MOMENTO 1: HERO CINEMÁTICO — EL VIDEO COMO PROTAGONISTA ABSOLUTO
     Sin textos ni cajas tapando el centro del video.
     ===================================================================== -->
<section class="relative bg-[#EAE5DC] overflow-hidden isolate">
  
  <!-- Ambient subtle glow behind the video stage -->
  <div class="absolute -top-24 left-1/4 w-96 h-96 rounded-full bg-purple-400/20 blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute -bottom-24 right-1/4 w-96 h-96 rounded-full bg-teal-400/20 blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

  <!-- Full-bleed / Widescreen Video Stage -->
  <div class="relative max-w-[1440px] mx-auto">
    
    <!-- Top floating subtle status pills (Never touches the center logo reveal) -->
    <div class="absolute top-3 sm:top-5 inset-x-4 sm:inset-x-8 z-20 flex items-center justify-between pointer-events-none">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 backdrop-blur-md border border-purple-200/80 text-purple-950 text-[11px] sm:text-xs font-semibold tracking-wide shadow-sm pointer-events-auto">
        <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
        <span>Santuario de Estética Holística · Bogotá</span>
      </div>

      <!-- Accessible Play/Pause Control Button (WCAG 2.2.2) -->
      <button
        type="button"
        id="hero-video-toggle"
        class="pointer-events-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/80 hover:bg-white text-slate-800 border border-purple-200/80 text-[11px] sm:text-xs font-semibold backdrop-blur-md shadow-sm transition-all cursor-pointer min-h-[36px]"
        aria-label="Pausar animación de video"
        title="Pausar o reproducir video"
      >
        <svg id="icon-video-pause" class="w-3.5 h-3.5 fill-current text-purple-800" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
        <svg id="icon-video-play" class="w-3.5 h-3.5 fill-current text-purple-800 hidden" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span id="label-video-toggle">Pausar</span>
      </button>
    </div>

    <!-- Centerpiece Unobstructed Video Canvas -->
    <div class="relative w-full aspect-16/10 sm:aspect-16/9 lg:aspect-21/9 max-h-[76vh] min-h-[300px] sm:min-h-[440px] flex items-center justify-center overflow-hidden bg-[#EAE5DC]">
      <video
        id="hero-main-video"
        class="w-full h-full object-contain sm:object-cover object-center scale-100 transition-opacity duration-700"
        poster="/images/hero-video-poster.webp"
        width="1280"
        height="720"
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
      >
        <source data-src="/videos/hero-pas-loop.mp4" type="video/mp4" />
      </video>

      <!-- Ultra-subtle bottom vignette ONLY at the very bottom edge to blend smoothly into the floating dock -->
      <div class="absolute inset-x-0 bottom-0 h-20 sm:h-28 bg-gradient-to-t from-stone-50 via-stone-50/40 to-transparent pointer-events-none" aria-hidden="true"></div>
    </div>

  </div>

  <!-- Floating Glass Dock at the bottom edge of the video stage -->
  <div class="relative z-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-12 pb-8 sm:pb-12">
    <div class="rounded-3xl bg-white/90 backdrop-blur-xl border border-purple-200/90 shadow-[0_20px_50px_rgba(94,67,121,0.12)] p-5 sm:p-7 lg:px-10 lg:py-7">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        
        <!-- Primary H1 Headline in the Dock -->
        <div class="text-center lg:text-left space-y-1.5 max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-widest text-teal-700">
            Salud, Belleza & Bienestar Emocional
          </p>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Tu refugio de pausa. <span class="font-serif italic font-normal text-purple-800">Belleza consciente</span> que sana desde el interior.
          </h1>
        </div>

        <!-- Immediate Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full lg:w-auto shrink-0">
          <a
            href={whatsappHeroUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-white bg-purple-700 hover:bg-purple-800 active:bg-purple-900 shadow-md hover:shadow-lg transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-purple-300 min-h-[48px]"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Agendar Cita en WhatsApp</span>
          </a>

          <a
            href="#esencia-y-resultados"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-6 py-3.5 rounded-full text-sm sm:text-base font-medium text-purple-950 bg-purple-50/90 hover:bg-purple-100/90 border border-purple-200 transition-colors min-h-[48px]"
          >
            <span>Descubrir P.A.S</span>
            <svg class="w-4 h-4 text-purple-700 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- =====================================================================
     MOMENTO 2: SECCIÓN EDITORIAL — EL SANTUARIO & RESULTADOS REALES
     Ubicada debajo del video para que cada elemento tenga su propio espacio.
     ===================================================================== -->
<section id="esencia-y-resultados" class="relative py-16 sm:py-24 bg-gradient-to-b from-stone-50 via-purple-50/35 to-stone-50 overflow-hidden scroll-mt-20">
  
  <!-- Decorative soft blurs -->
  <div class="absolute top-12 right-10 -z-10 w-80 h-80 rounded-full bg-purple-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-10 -z-10 w-80 h-80 rounded-full bg-teal-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      
      <!-- Narrative & Bento Pillars (6 cols) -->
      <div class="lg:col-span-6 space-y-6 sm:space-y-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-900 text-xs uppercase tracking-widest font-bold">
          Ciencia Dérmica & Armonía Interior
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.15]">
          Un santuario diseñado para la <span class="font-serif italic font-normal text-purple-800">desconexión total</span> y resultados visibles.
        </h2>

        <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
          Más que una cabina estética tradicional, <strong class="text-slate-900 font-semibold">P.A.S</strong> integra protocolos clínicos no invasivos de alta eficacia con aromaterapia y armonización energética. Aquí no vienes con prisa: cada sesión renueva tu piel mientras libera el estrés acumulado en tu cuerpo.
        </p>

        <!-- Bento Trust Cards (3 Pillars) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              360°
            </span>
            <h3 class="text-sm font-bold text-slate-900">Enfoque Integral</h3>
            <p class="text-xs text-slate-600 mt-0.5">Cuerpo, mente y energía en sintonía</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-teal-200/80 shadow-xs hover:shadow-md hover:border-teal-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-teal-50 text-teal-800 font-serif font-bold text-lg mb-2">
              1:1
            </span>
            <h3 class="text-sm font-bold text-slate-900">Sin Prisas</h3>
            <p class="text-xs text-slate-600 mt-0.5">Cabina privada exclusiva para ti</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              100%
            </span>
            <h3 class="text-sm font-bold text-slate-900">A tu Medida</h3>
            <p class="text-xs text-slate-600 mt-0.5">Diagnóstico previo personalizado</p>
          </div>
        </div>

        <!-- Secondary link to catalog -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="#servicios"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-purple-900 bg-white hover:bg-purple-50 border-2 border-purple-200 shadow-xs transition-all min-h-[48px]"
          >
            <span>Explorar Catálogo de Tratamientos</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Interactive Before/After Showcase (6 cols) -->
      <div class="lg:col-span-6 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Ambient frame border with purple & mint gradient -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-purple-400/30 via-teal-300/30 to-purple-200/40 blur-md -z-10" aria-hidden="true"></div>
          
          <BeforeAfterSlider />

          <!-- Location & Exclusivity badge below slider -->
          <div class="mt-4 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md border border-purple-200 shadow-md flex items-center justify-between text-xs text-slate-700">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-bold text-slate-900">Atención Exclusiva en Bogotá</span>
            </div>
            <span class="text-purple-800 font-semibold text-[11px]">
              Carrera 53A #127 · Cita previa
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initHeroVideo() {
    const mainVideo = document.getElementById('hero-main-video') as HTMLVideoElement | null;
    const toggleBtn = document.getElementById('hero-video-toggle') as HTMLButtonElement | null;
    const iconPause = document.getElementById('icon-video-pause');
    const iconPlay = document.getElementById('icon-video-play');
    const labelToggle = document.getElementById('label-video-toggle');

    if (!mainVideo) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = (navigator as unknown as { connection?: { saveData?: boolean } }).connection;
    const saveData = Boolean(connection?.saveData);

    function setToggleUI(isPaused: boolean) {
      if (!toggleBtn || !iconPause || !iconPlay || !labelToggle) return;
      if (isPaused) {
        iconPause.classList.add('hidden');
        iconPlay.classList.remove('hidden');
        labelToggle.textContent = 'Reproducir';
        toggleBtn.setAttribute('aria-label', 'Reproducir animación de video');
      } else {
        iconPause.classList.remove('hidden');
        iconPlay.classList.add('hidden');
        labelToggle.textContent = 'Pausar';
        toggleBtn.setAttribute('aria-label', 'Pausar animación de video');
      }
    }

    function hydrateAndPlay() {
      if (!mainVideo) return;
      mainVideo.muted = true;
      mainVideo.defaultMuted = true;
      mainVideo.playsInline = true;

      const source = mainVideo.querySelector('source');
      if (source && source.dataset.src && !source.getAttribute('src')) {
        source.setAttribute('src', source.dataset.src);
        mainVideo.load();
      }

      const playPromise = mainVideo.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => setToggleUI(false))
          .catch(() => setToggleUI(true));
      }
    }

    if (!prefersReducedMotion && !saveData) {
      if ('requestIdleCallback' in window) {
        (window as Window & { requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => void })
          .requestIdleCallback(hydrateAndPlay, { timeout: 600 });
      } else {
        setTimeout(hydrateAndPlay, 100);
      }
    } else {
      setToggleUI(true);
    }

    toggleBtn?.addEventListener('click', () => {
      if (!mainVideo.paused) {
        mainVideo.pause();
        setToggleUI(true);
      } else {
        hydrateAndPlay();
        setToggleUI(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>
