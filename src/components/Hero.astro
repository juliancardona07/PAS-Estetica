---
import BeforeAfterSlider from './BeforeAfterSlider.astro';
---

<section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-purple-50/55 via-stone-50 to-stone-50 pt-10 pb-16 sm:pt-14 sm:pb-24 scroll-mt-24">
  <!-- Subtle decorative background blurs -->
  <div class="absolute top-0 right-1/4 -z-10 w-96 h-96 rounded-full bg-purple-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-10 -z-10 w-80 h-80 rounded-full bg-teal-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Text & Bento Pillars Content (6 cols) -->
      <div class="lg:col-span-6 space-y-6 sm:space-y-7 text-center lg:text-left">
        
        <!-- Category Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-100/90 border border-purple-200/70 text-purple-900 text-xs sm:text-sm font-medium tracking-wide">
          <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
          Salud, Belleza & Bienestar Emocional en Bogotá
        </div>

        <!-- Main H1 -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.35rem] font-bold tracking-tight text-slate-900 leading-[1.14]">
          Tu refugio de pausa. <br class="hidden sm:inline" />
          <span class="font-serif italic font-normal text-purple-800">Belleza consciente</span> <br class="hidden sm:inline" />
          que sana desde el interior.
        </h1>

        <!-- Descriptive Paragraph from BRIEF -->
        <p class="text-base sm:text-lg text-slate-700 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Más que una cabina estética tradicional, <strong class="text-slate-900 font-semibold">P.A.S</strong> es un santuario diseñado para la desconexión total. Integramos protocolos clínicos no invasivos de alta eficacia dérmica con aromaterapia y armonización energética, entendiendo que la verdadera belleza es el reflejo de tu equilibrio interno.
        </p>

        <!-- Bento Trust Cards (3 Pillars) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1 text-left">
          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              360°
            </span>
            <h2 class="text-sm font-bold text-slate-900">Enfoque Integral</h2>
            <p class="text-xs text-slate-600 mt-0.5">Cuerpo, mente y energía en sintonía</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-teal-200/80 shadow-xs hover:shadow-md hover:border-teal-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-teal-50 text-teal-800 font-serif font-bold text-lg mb-2">
              1:1
            </span>
            <h2 class="text-sm font-bold text-slate-900">Sin Prisas</h2>
            <p class="text-xs text-slate-600 mt-0.5">Cabina privada exclusiva para ti</p>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-300 transition-all">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-purple-100 text-purple-800 font-serif font-bold text-lg mb-2">
              100%
            </span>
            <h2 class="text-sm font-bold text-slate-900">A tu Medida</h2>
            <p class="text-xs text-slate-600 mt-0.5">Diagnóstico previo personalizado</p>
          </div>
        </div>

        <!-- Secondary link to catalog -->
        <div class="pt-1 flex flex-wrap items-center justify-center lg:justify-start gap-4">
          <a
            href="#servicios"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-purple-900 bg-white hover:bg-purple-50 border-2 border-purple-200 shadow-xs transition-all min-h-[48px]"
          >
            <span>Explorar Catálogo de Tratamientos</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>

      </div>

      <!-- Hero Interactive Before/After Visual (6 cols) -->
      <div class="lg:col-span-6 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Ambient frame border with purple & mint gradient -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-purple-400/30 via-teal-300/30 to-purple-200/40 blur-md -z-10" aria-hidden="true"></div>
          
          <BeforeAfterSlider />

          <!-- Location & Exclusivity badge below slider -->
          <div class="mt-4 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md border border-purple-200 shadow-md flex items-center justify-between text-xs text-slate-700">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-bold text-slate-900">Atención Exclusiva en Bogotá</span>
            </div>
            <span class="text-purple-800 font-semibold text-[11px]">
              Carrera 53A #127 · Cita previa
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
