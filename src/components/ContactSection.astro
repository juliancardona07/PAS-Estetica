---
const serviceOptions = [
  "Limpieza Facial Profunda & Oxigenación ($120.000)",
  "Lifting Facial Holístico & Radiofrecuencia ($160.000)",
  "Moldeo Corporal & Drenaje Linfático 360° ($140.000)",
  "Terapia Holística con Piedras Volcánicas ($135.000)",
  "Ritual P.A.S 'Pausa Holística Integral' ($220.000)",
  "Exfoliación & Manto Hidratante Botánico ($110.000)",
  "Valoración / Diagnóstico Personalizado Inicial",
  "Otra consulta"
];
---

<section id="contacto" class="py-20 sm:py-28 bg-stone-50 border-t border-purple-100 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Contact Info & Location (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <span class="text-xs uppercase tracking-widest text-purple-700 font-semibold">
            Estamos en Bogotá
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight">
            Reserva tu momento de <span class="font-serif italic font-normal text-purple-800">pausa y sanación</span>
          </h2>
          <p class="text-base text-slate-600 leading-relaxed">
            Te esperamos en nuestro espacio privado en Bogotá. Escríbenos, llámanos o completa el formulario para coordinar tu cita con tiempo.
          </p>
        </div>

        <!-- Contact Data Cards -->
        <div class="space-y-4">
          
          <!-- Direction -->
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white border border-purple-100 shadow-xs">
            <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Ubicación Cabina</h3>
              <p class="text-sm text-slate-600 mt-0.5">Carrera 53A #127, Bogotá, Colombia</p>
              <p class="text-xs text-purple-700 mt-1 font-medium">Sector Prado Veraniego / Calle 127 · Fácil acceso</p>
            </div>
          </div>

          <!-- WhatsApp / Tel -->
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white border border-purple-100 shadow-xs">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">WhatsApp Comercial</h3>
              <p class="text-sm text-slate-600 mt-0.5">
                <a href="https://wa.me/573118735759" target="_blank" rel="noopener noreferrer" class="hover:text-purple-700 font-semibold">
                  +57 311 873 5759
                </a>
              </p>
              <p class="text-xs text-slate-500 mt-1">Respuesta rápida en horario de cabina</p>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white border border-purple-100 shadow-xs">
            <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Correo Electrónico</h3>
              <p class="text-sm text-slate-600 mt-0.5 break-all">
                <a href="mailto:paulaandreasuarez0@gmail.com" class="hover:text-purple-700 font-medium">
                  paulaandreasuarez0@gmail.com
                </a>
              </p>
            </div>
          </div>

        </div>

        <!-- Google Maps view link box -->
        <div class="p-5 rounded-2xl bg-purple-50/70 border border-purple-200/60">
          <p class="text-xs font-bold text-purple-900 uppercase tracking-wider mb-1">
            ¿Cómo llegar?
          </p>
          <p class="text-xs text-purple-950 leading-relaxed mb-3">
            Ubicados estratégicamente sobre el corredor de la Calle 127 en Bogotá, cerca a la Autopista Norte y Av. Suba.
          </p>
          <a
            href="https://maps.google.com/?q=Carrera+53A+%23127+Bogota"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-700 hover:text-purple-900"
          >
            <span>Ver mapa en Google Maps</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Contact / Reservation Form (7 cols) -->
      <div class="lg:col-span-7">
        <div class="bg-white p-8 sm:p-10 rounded-3xl border border-purple-100 shadow-md">
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-slate-900">Solicitar Información o Cita Previa</h3>
            <p class="text-sm text-slate-600 mt-1">
              Diligencia tus datos y envíanos tu mensaje. También puedes canalizar tu solicitud directamente a nuestro WhatsApp oficial.
            </p>
          </div>

          <form id="appointment-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Nombre completo <span class="text-purple-600">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Ej: Laura Martínez"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-purple-600 focus:ring-2 focus:ring-purple-200 text-sm text-slate-900 placeholder-slate-400 transition-colors"
                />
              </div>

              <div>
                <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  WhatsApp o Teléfono <span class="text-purple-600">*</span>
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  required
                  placeholder="Ej: 310 123 4567"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-purple-600 focus:ring-2 focus:ring-purple-200 text-sm text-slate-900 placeholder-slate-400 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Correo Electrónico <span class="text-purple-600">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="ejemplo@correo.com"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-purple-600 focus:ring-2 focus:ring-purple-200 text-sm text-slate-900 placeholder-slate-400 transition-colors"
              />
            </div>

            <div>
              <label for="contact-service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Servicio o Tratamiento de Interés
              </label>
              <select
                id="contact-service"
                name="service"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-purple-600 focus:ring-2 focus:ring-purple-200 text-sm text-slate-900 bg-white transition-colors"
              >
                {serviceOptions.map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Mensaje o consulta sobre tu piel / disponibilidad
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                placeholder="Cuéntanos qué objetivo deseas alcanzar o en qué horario prefieres tu cita..."
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-purple-600 focus:ring-2 focus:ring-purple-200 text-sm text-slate-900 placeholder-slate-400 transition-colors resize-y"
              ></textarea>
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl text-base font-semibold text-white bg-purple-700 hover:bg-purple-800 active:bg-purple-900 shadow-md hover:shadow-lg transition-all duration-200 focus:outline-hidden focus:ring-4 focus:ring-purple-300 min-h-[48px]"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Enviar Solicitud a WhatsApp Oficial</span>
              </button>
            </div>

            <!-- Confirmation message -->
            <div id="form-feedback" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm text-center">
              ✓ Solicitud preparada. Abriendo WhatsApp para coordinar tu cita directamente con Paula...
            </div>

            <p class="text-[11px] text-slate-500 text-center">
              🔒 Tus datos son confidenciales y se utilizarán únicamente para responder a tu requerimiento de atención estética.
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('appointment-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get('name') || '';
      const phone = formData.get('phone') || '';
      const email = formData.get('email') || '';
      const service = formData.get('service') || '';
      const message = formData.get('message') || '';

      const text = `¡Hola Paula! Vengo del formulario web de P.A.S Estética Holística:\n\n• Nombre: ${name}\n• Teléfono: ${phone}\n• Email: ${email}\n• Servicio: ${service}\n• Mensaje: ${message}\n\n¿Podrías indicarme disponibilidad para una cita?`;
      
      const whatsappUrl = `https://wa.me/573118735759?text=${encodeURIComponent(text)}`;

      if (feedback) {
        feedback.classList.remove('hidden');
      }

      setTimeout(() => {
        window.open(whatsappUrl, '_blank');
      }, 600);
    });
  }
</script>

