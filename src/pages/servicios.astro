---
import Layout from '../layouts/Layout.astro';
import ServicesSection from '../components/ServicesSection.astro';
---

<Layout
  title="Catálogo de Servicios y Tratamientos | P.A.S Estética Holística Bogotá"
  description="Conoce en detalle nuestros faciales holísticos, corporal y aparatología, bienestar y relajación, peso ideal, cursos y círculos holísticos en Bogotá."
>
  <section class="bg-gradient-to-b from-purple-100/60 to-stone-50 py-14 sm:py-20 border-b border-purple-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <nav class="flex justify-center text-xs text-slate-500 gap-2 mb-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-purple-700">Inicio</a>
        <span>/</span>
        <span class="text-purple-800 font-semibold">Servicios</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 leading-tight">
        Catálogo Completo de <span class="font-serif italic font-normal text-purple-800">Tratamientos &amp; Servicios</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
        Explora cada categoría y abre el menú detallado de tratamientos para conocer cómo acompañamos tu piel, tu cuerpo y tu energía.
      </p>
    </div>
  </section>

  <ServicesSection />
</Layout>
