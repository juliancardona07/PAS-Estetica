---
import Layout from '../layouts/Layout.astro';
import servicesData from '../data/services.json';
---

<Layout
  title="Catálogo de Servicios y Tarifas | P.A.S Estética Holística Bogotá"
  description="Conoce en detalle nuestros tratamientos faciales holísticos, protocolos corporales conscientes y masajes relajantes con piedras volcánicas en Bogotá."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-purple-100/60 to-stone-50 py-16 sm:py-24 border-b border-purple-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <nav class="flex justify-center text-xs text-slate-500 gap-2 mb-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-purple-700">Inicio</a>
        <span>/</span>
        <span class="text-purple-800 font-semibold">Servicios</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 leading-tight">
        Catálogo Completo de <span class="font-serif italic font-normal text-purple-800">Tratamientos & Tarifas</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
        Protocolos diseñados con cosmética botánica, aparatología de vanguardia y atención personalizada para cuidar tu piel y calmar tu mente.
      </p>
    </div>
  </section>

  <!-- Detailed Services List -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {servicesData.map((service, idx) => {
        const whatsappLink = "https://wa.me/573118735759?text=" + encodeURIComponent(`Hola Paula, me interesa agendar el servicio: "${service.name}" (${service.price}).`);
        const isEven = idx % 2 === 1;

        return (
          <article class={`grid grid-cols-1 md:grid-cols-12 gap-8 items-center p-8 rounded-3xl bg-stone-50 border border-purple-100/80 shadow-xs ${isEven ? 'md:flex-row-reverse' : ''}`}>
            
            <!-- Image Column -->
            <div class="md:col-span-5 relative overflow-hidden rounded-2xl aspect-4/3 bg-slate-200">
              <img
                src={service.image}
                alt={service.name}
                width={service.imageWidth}
                height={service.imageHeight}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-white/95 text-xs font-bold text-purple-900 shadow-xs">
                {service.category}
              </span>
            </div>

            <!-- Details Column -->
            <div class="md:col-span-7 space-y-4">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="font-serif text-2xl font-bold text-slate-900">
                  {service.name}
                </h2>
                <span class="text-xl font-bold text-purple-800">{service.price}</span>
              </div>

              <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                <span class="bg-purple-100/80 text-purple-800 px-2.5 py-0.5 rounded-full">
                  ⏱ Duración: {service.duration}
                </span>
                <span>•</span>
                <span>Atención 1 a 1 exclusiva</span>
              </div>

              <p class="text-sm text-slate-600 leading-relaxed">
                {service.fullDescription}
              </p>

              <!-- Benefits List -->
              <div class="space-y-1.5 pt-2">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-700">Beneficios destacados:</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1 text-xs text-slate-600">
                  {service.benefits.map(b => (
                    <li class="flex items-center gap-1.5">
                      <span class="text-teal-600 font-bold">✓</span> {b}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- CTA -->
              <div class="pt-4 flex items-center gap-4">
                <a
                  href={whatsappLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-purple-700 hover:bg-purple-800 transition-colors shadow-xs"
                >
                  <span>Agendar por WhatsApp</span>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                </a>
              </div>
            </div>

          </article>
        );
      })}
    </div>
  </section>
</Layout>

