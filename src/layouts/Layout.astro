---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "P.A.S Estética Holística | Paula Andrea Suárez | Bogotá",
  description = "Espacio de salud, estética y belleza consciente en Bogotá. Tratamientos faciales, corporales y terapias holísticas que integran cuerpo, mente y energía.",
  image = "/images/hero-wellness.webp",
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteUrl = "https://pasestetica.com";
const fullImageUrl = new URL(image, siteUrl).toString();

const schemaData = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "name": "P.A.S Estética Holística",
  "alternateName": "Paula Andrea Suárez Estética Holística Integral",
  "image": fullImageUrl,
  "description": description,
  "url": siteUrl,
  "telephone": "+573118735759",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Carrera 53A #127",
    "addressLocality": "Bogotá",
    "addressRegion": "Cundinamarca",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "4.7088",
    "longitude": "-74.0628"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "15:00"
    }
  ],
  "sameAs": [
    "https://www.instagram.com/pasesteticaholistica",
    "https://www.facebook.com/pasesteticaintegral"
  ],
  "priceRange": "$$"
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Paula Andrea Suárez" />
    <meta name="keywords" content="estetica holistica bogota, spa bogota, limpieza facial profunda, drenaje linfatico, masajes relajantes, belleza consciente, paula andrea suarez" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="P.A.S Estética Holística" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Preconnect & Google Fonts (Strict compliance with AGENTS.md rule 8) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-stone-50 text-slate-800 antialiased min-h-screen flex flex-col font-sans selection:bg-purple-200 selection:text-purple-900">
    <a href="#contenido-principal" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-purple-700 focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none">
      Saltar al contenido principal
    </a>

    <Header />

    <main id="contenido-principal" class="flex-grow">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
  </body>
</html>

<style is:global>
  h1, h2, h3, .font-serif {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>
